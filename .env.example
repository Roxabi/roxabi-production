ENABLE_LSP_TOOL=1

# --- Dev server ---
ROXVID_PORT=3002

# --- Freesound API ---
# Get yours: https://freesound.org/apiv2/apply/ (free, instant)
# Register → "Create new API credential" → copy the "Client id"
FREESOUND_API_KEY=
FREESOUND_API_SECRET=

# --- dev-core: GitHub Project V2 (optional) ---
# Auto-detected by /init for projects using dev-core's GitHub Project board
GITHUB_REPO=
GH_PROJECT_ID=
STATUS_FIELD_ID=
SIZE_FIELD_ID=
PRIORITY_FIELD_ID=

# --- dev-core: Field option IDs (auto-detected by /init) ---
STATUS_OPTIONS_JSON=
SIZE_OPTIONS_JSON=
PRIORITY_OPTIONS_JSON=

# --- dev-core: Vercel (optional) ---
# VERCEL_TOKEN=
# VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=
