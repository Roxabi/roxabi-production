{
  "duration": 110.0,
  "fps": 30,
  "chunks": [
    {
      "id": "c01",
      "start": 6.0,
      "duration": 1.92,
      "text": "You already know how to build this.",
      "anchor": 6.166666666666667,
      "anchor_label": "S01 typewriter f185",
      "flags": []
    },
    {
      "id": "c02",
      "start": 8.5,
      "duration": 2.16,
      "text": "You've already built it five times.",
      "anchor": 8.5,
      "anchor_label": "S01 mono 'five times' f255",
      "flags": []
    },
    {
      "id": "c03",
      "start": 11.2,
      "duration": 4.64,
      "text": "A team of fifty has someone on the orchestration layer. You don't.",
      "anchor": 10.4,
      "anchor_label": "S02 team-cluster appear localF12",
      "flags": []
    },
    {
      "id": "c04",
      "start": 16.5,
      "duration": 1.6,
      "text": "So every project starts the same way.",
      "anchor": 15.0,
      "anchor_label": "S02 scaffold start localF150",
      "flags": []
    },
    {
      "id": "c05",
      "start": 21.0,
      "duration": 2.96,
      "text": "The gap isn't skill. It's foundations.",
      "anchor": 21.0,
      "anchor_label": "S02 'foundations' localF330",
      "flags": []
    },
    {
      "id": "c06",
      "start": 27.5,
      "duration": 1.76,
      "text": "Roxabi starts with the smith.",
      "anchor": 27.666666666666668,
      "anchor_label": "S03 hero-text localF80",
      "flags": []
    },
    {
      "id": "c07",
      "start": 31.0,
      "duration": 3.76,
      "text": "Fourteen years orchestrating teams. Now agents.",
      "anchor": 31.666666666666668,
      "anchor_label": "S03 '14 years' localF200",
      "flags": []
    },
    {
      "id": "c08",
      "start": 36.3,
      "duration": 2.16,
      "text": "Same craft. New material.",
      "anchor": 36.333333333333336,
      "anchor_label": "S03 'Same craft' localF340",
      "flags": []
    },
    {
      "id": "c09",
      "start": 43.0,
      "duration": 3.28,
      "text": "The layer underneath your editor. Above the hardware.",
      "anchor": 43.666666666666664,
      "anchor_label": "S04 terminal fade localF50",
      "flags": []
    },
    {
      "id": "c10",
      "start": 46.8,
      "duration": 3.52,
      "text": "The part that doesn't change between projects.",
      "anchor": 46.333333333333336,
      "anchor_label": "S04 creed header localF130",
      "flags": []
    },
    {
      "id": "c11",
      "start": 50.8,
      "duration": 1.76,
      "text": "Roxabi is six lines.",
      "anchor": 50.666666666666664,
      "anchor_label": "S04 'local' localF260",
      "flags": []
    },
    {
      "id": "c12",
      "start": 53.0,
      "duration": 4.88,
      "text": "Open by architecture. Local by default. Compounding.",
      "anchor": 48.666666666666664,
      "anchor_label": "S04 'open by arch' localF200",
      "flags": [
        "VO_TRAIL(+4.3s)"
      ]
    },
    {
      "id": "c13",
      "start": 58.4,
      "duration": 5.12,
      "text": "MIT. No telemetry. Yours the moment you clone.",
      "anchor": 59.0,
      "anchor_label": "S04 'yours' localF510",
      "flags": []
    },
    {
      "id": "c14",
      "start": 64.0,
      "duration": 2.48,
      "text": "Not a framework. Primitives.",
      "anchor": 68.33333333333333,
      "anchor_label": "S05 'Primitives' label localF10",
      "flags": [
        "VO_LEAD(-4.3s)"
      ]
    },
    {
      "id": "c15",
      "start": 68.4,
      "duration": 8.72,
      "text": "Routing. State. Orchestration. Harness. Tool connectors.",
      "anchor": 70.0,
      "anchor_label": "S05 first node localF60",
      "flags": []
    },
    {
      "id": "c16",
      "start": 77.6,
      "duration": 3.52,
      "text": "Each one stands alone. Together, they compound.",
      "anchor": 76.0,
      "anchor_label": "S05 edges localF240",
      "flags": []
    },
    {
      "id": "c17",
      "start": 81.6,
      "duration": 2.08,
      "text": "Around the forge, a guild.",
      "anchor": 82.33333333333333,
      "anchor_label": "S06 LAYER 03 badge localF10",
      "flags": []
    },
    {
      "id": "c18",
      "start": 84.2,
      "duration": 5.28,
      "text": "Builders who fork. Contributors who extend what came before.",
      "anchor": 84.0,
      "anchor_label": "S06 forks essaime localF60",
      "flags": []
    },
    {
      "id": "c19",
      "start": 90.0,
      "duration": 5.12,
      "text": "Roxabi extends open source. Open source extends Roxabi.",
      "anchor": 90.0,
      "anchor_label": "S06 mirror line localF240",
      "flags": []
    },
    {
      "id": "c20",
      "start": 104.5,
      "duration": 3.84,
      "text": "One person. Team-scale output.",
      "anchor": 104.66666666666667,
      "anchor_label": "S07 'One person.' localF260",
      "flags": []
    }
  ],
